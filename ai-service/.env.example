# ─── Server ───────────────────────────────────────────────────────────────────
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development          # development | production
AI_SERVICE_DEBUG=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ─── Model paths ──────────────────────────────────────────────────────────────
SAVED_MODELS_DIR=./saved_models
ACTIVE_MODEL=mambavision           # mambavision | cnn | vgg16 | resnet50 | efficientnet

# ─── Image settings ───────────────────────────────────────────────────────────
IMAGE_SIZE=224                      # target width = height in pixels
IMAGE_CHANNELS=3

# ─── Classes ──────────────────────────────────────────────────────────────────
# Comma-separated list matching model output indices
CLASS_NAMES=glioma,meningioma,notumor,pituitary

# ─── Dataset paths ────────────────────────────────────────────────────────────
DATASET_RAW_DIR=./dataset/raw
DATASET_PROCESSED_DIR=./dataset/processed

# ─── Grad-CAM output ──────────────────────────────────────────────────────────
GRADCAM_OUTPUT_DIR=./gradcam_output

# ─── Security / JWT ───────────────────────────────────────────────────────────
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Auth mode: "public" (no token required for /predict) | "authenticated"
PREDICTION_AUTH_MODE=public

# ─── Seed account passwords ────────────────────────────────────────────────────
# Development defaults are shown below.
# In production ALL four MUST be set to strong unique secrets via environment
# variables. The service will refuse to start in production if any value is
# still the placeholder shown here.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(24))"
DEFAULT_ADMIN_PASSWORD=Admin@123!
DEFAULT_RESEARCHER_PASSWORD=Research@123!
DEFAULT_OPERATOR_PASSWORD=Operator@123!
DEFAULT_VIEWER_PASSWORD=Viewer@123!

# ─── Rate limiting (requests per minute) ──────────────────────────────────────
RATE_LIMIT_LOGIN=5
RATE_LIMIT_PREDICTION=60
RATE_LIMIT_BATCH_PREDICTION=10
RATE_LIMIT_TRAINING=5
RATE_LIMIT_DASHBOARD=120

# ─── Account lockout ──────────────────────────────────────────────────────────
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
AUDIT_LOG_DIR=./logs/audit
